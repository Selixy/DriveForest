{
	"folders": [
		{
			"path": ".",
			"name": "Root"
		},
		{
			"path": "Unity_DriveSim/Assets/Scripts",
			"name": "Unity"
		},
		{
			"path": "Controller/Server",
			"name": "Server"
		},
		{
			"path": "Controller/Arduino",
            "name": "Arduino"
		},
		{
			"path": "Assets",
			"name": "Assets"
		},
	],
	"settings": {
        "files.exclude": {
            "**/bin": true,
            "**/obj": true,
            "**/Library": true,
            "**/Temp": true,
            "**/Logs": true,
            "**/MemoryCaptures": true,
            "**/*.sln": true,
            "**/*.csproj": true,
            "**/*.unityproj": true,
            "**/*.pidb": true,
            "**/*.userprefs": true,
            "**/*.unitypackage": true,
            "**/*.meta": true,
            "**/*.asset": true,


            ".stfolder": true,
            "Assets": true,
            "Controller": true,
            "Unity_DriveSim": true,
			".cargo": true,
			"target": true,
        },
	},
	"extensions": {
		"recommendations": [
			"ms-python.python",
			"ms-vscode.powershell",
			"ms-dotnettools.csharp",
			"ms-vscode.cpptools",
			"esbenp.prettier-vscode",
		]
	},
	"tasks": {
		"version": "2.0.0",
		"tasks": [
			{
				"label": "▶ Run Server",
				"type": "shell",
				"command": "powershell",
				"args": [
					"-NoProfile",
					"-ExecutionPolicy",
					"Bypass",
					"-File",
					"${workspaceFolder}/Controller/Server/utils/run.ps1",
					"-Build"
				],
				"options": {
					"cwd": "${workspaceFolder}/Controller/Server"
				},
				"group": {
					"kind": "build",
					"isDefault": true
				},
				"presentation": {
					"echo": true,
					"reveal": "always",
					"focus": true,
					"panel": "shared"
				},
				"isBackground": false
			},
			{
				"label": "🧪 Test Server",
				"type": "shell",
				"command": "cargo",
				"args": [
					"test",
					"--manifest-path",
					"${workspaceFolder}/Controller/Server/Cargo.toml"
				],
				"group": "test",
				"presentation": {
					"echo": true,
					"reveal": "always",
					"focus": false,
					"panel": "shared"
				}
			},
			{
				"label": "🧹 Clean Server",
				"type": "shell",
				"command": "cargo",
				"args": [
					"clean",
					"--manifest-path",
					"${workspaceFolder}/Controller/Server/Cargo.toml"
				],
				"group": "build",
				"presentation": {
					"echo": true,
					"reveal": "always",
					"focus": false,
					"panel": "shared"
				}
			}
		]
	}
}
